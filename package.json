{
  "name": "@local/dsh-sao-link-start",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "SAO风格DSH皮肤：双启动动画与角色语音、独立透明度、连续右栏液态玻璃与上下文叠层、自定义壁纸及模型强度调节",
  "author": "GXinnnnnn",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/GXinnnnnn/dsh-SAO.git"
  },
  "icon": "./icon.png",
  "homepage": "https://github.com/GXinnnnnn/dsh-SAO#readme",
  "bugs": {
    "url": "https://github.com/GXinnnnnn/dsh-SAO/issues"
  },
  "keywords": [
    "dsh-plugin",
    "sao",
    "link-start",
    "startup-animation",
    "webgl"
  ],
  "exports": {
    ".": "./index.js",
    "./host": "./index.js",
    "./host/icon": "./icon.png",
    "./host/locale/*.json": "./locale/*.json",
    "./client": "./client.js",
    "./icon": "./icon.png",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "startup.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "icon.ico",
    "locale",
    "source",
    "README.md",
    "SOURCE.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "screenshots.json",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ],
      "external": [
        "react"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
